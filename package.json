{
  "name": "@liangjiehappy/dsh-plugin-cadpop",
  "version": "0.1.9",
  "description": "CADPOP 在线 CAD 工具入口：模板清单、帮助中心、DFM 制造分析、编辑器与图纸工具页。只访问 cadpop.com。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "permissions": [
      "network"
    ]
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cadpop",
    "cad",
    "dxf",
    "dfm"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldkey/dsh-plugin-cadpop.git"
  },
  "homepage": "https://github.com/moldkey/dsh-plugin-cadpop",
  "bugs": {
    "url": "https://github.com/moldkey/dsh-plugin-cadpop/issues"
  }
}
